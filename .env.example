# =============================================================================
# SIPERIS - ENVIRONMENT VARIABLES CONFIGURATION (.env)
# =============================================================================

# Port aplikasi backend server lokal (default: 4173)
PORT=4173

# Mode lingkungan: development / production
NODE_ENV=production

# Lokasi file database (default: perizinan.db di lokal, /tmp/perizinan.db di Vercel)
# DB_PATH=./perizinan.db

# Database eksternal opsional (PostgreSQL / Supabase / Neon)
# DATABASE_URL=postgresql://user:password@host:5432/siperis

# Pengaturan idle auto-logout sesi pengguna (dalam menit)
IDLE_TIMEOUT_MENIT=30

# Toleransi batas keterlambatan siswa sebelum notifikasi terpicu (dalam menit)
BATAS_TERLAMBAT_MENIT=15

# Jam sekolah efektif untuk validasi otomatis pengajuan izin
JAM_MASUK=06:30
JAM_PULANG=16:00

